/dts-v1/;

/ {
	qcom,pmic-id-size = <0x09>;
	qcom,pmic-id = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x2e>;
	model = "Qualcomm Technologies, Inc. Parrot WCN6750 IDP 4GB DDR + AMOLED + RCM";
	compatible = "qcom,parrot-idp\0qcom,parrot\0qcom,idp";
	qcom,msm-id = <0x219 0x10000>;
	qcom,board-id = <0x22 0x602>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			bt_wcn6750 {
				compatible = "qcom,wcn6750-bt";
				pinctrl-names = "default";
				pinctrl-0 = <0xffffffff>;
				qcom,bt-reset-gpio = <0xffffffff 0x23 0x00>;
				qcom,bt-sw-ctrl-gpio = <0xffffffff 0x3d 0x00>;
				qcom,wl-reset-gpio = <0xffffffff 0x24 0x00>;
				tsens = "quiet-therm";
				qcom,bt-vdd-io-supply = <0xffffffff>;
				qcom,bt-vdd-aon-supply = <0xffffffff>;
				qcom,bt-vdd-dig-supply = <0xffffffff>;
				qcom,bt-vdd-rfacmn-supply = <0xffffffff>;
				qcom,bt-vdd-rfa-0p8-supply = <0xffffffff>;
				qcom,bt-vdd-rfa1-supply = <0xffffffff>;
				qcom,bt-vdd-rfa2-supply = <0xffffffff>;
				qcom,bt-vdd-ipa-2p2-supply = <0xffffffff>;
				qcom,bt-vdd-io-config = <0x1b7740 0x1e8480 0x00 0x01>;
				qcom,bt-vdd-aon-config = <0xc92c0 0x11e9f0 0x00 0x01>;
				qcom,bt-vdd-dig-config = <0xc92c0 0x11e9f0 0x00 0x01>;
				qcom,bt-vdd-rfacmn-config = <0xc92c0 0x11e9f0 0x00 0x01>;
				qcom,bt-vdd-rfa-0p8-config = <0xc92c0 0x11e9f0 0x00 0x01>;
				qcom,bt-vdd-rfa1-config = <0x1c9080 0x1f20c0 0x00 0x01>;
				qcom,bt-vdd-rfa2-config = <0x132a40 0x193cf0 0x00 0x01>;
				qcom,bt-vdd-ipa-2p2-config = <0x2191c0 0x21b100 0x00 0x01>;
				phandle = <0x33>;
			};

			qcom,smp2p-wpss {

				qcom,smp2p-wlan-2-in {
					qcom,entry-name = "wlan_soc_wake";
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x04>;
				};

				qcom,smp2p-wlan-2-out {
					qcom,entry-name = "wlan_soc_wake";
					#qcom,smem-state-cells = <0x01>;
					phandle = <0x02>;
				};

				qcom,smp2p-wlan-3-out {
					qcom,entry-name = "wlan_ep_power_save";
					#qcom,smem-state-cells = <0x01>;
					phandle = <0x03>;
				};
			};

			remoteproc-wpss@8a00000 {
				firmware-name = "qca6750/wpss.mdt";
				phandle = <0x01>;
			};

			qcom,wcn6750 {
				compatible = "qcom,wcn6750";
				reg = <0x17210040 0x00 0xb0000000 0x10000>;
				reg-names = "msi_addr\0smmu_iova_ipa";
				qcom,rproc-handle = <0x01>;
				iommus = <0xffffffff 0x1c00 0x01>;
				interrupts = <0x00 0x300 0x01 0x00 0x301 0x01 0x00 0x302 0x01 0x00 0x303 0x01 0x00 0x304 0x01 0x00 0x305 0x01 0x00 0x306 0x01 0x00 0x307 0x01 0x00 0x308 0x01 0x00 0x309 0x01 0x00 0x30a 0x01 0x00 0x30b 0x01 0x00 0x30c 0x01 0x00 0x30d 0x01 0x00 0x30e 0x01 0x00 0x30f 0x01 0x00 0x310 0x01 0x00 0x311 0x01 0x00 0x312 0x01 0x00 0x313 0x01 0x00 0x314 0x01 0x00 0x315 0x01 0x00 0x316 0x01 0x00 0x317 0x01 0x00 0x318 0x01 0x00 0x319 0x01 0x00 0x31a 0x01 0x00 0x31b 0x01 0x00 0x31c 0x01 0x00 0x31d 0x01 0x00 0x31e 0x01 0x00 0x31f 0x01>;
				qcom,iommu-dma = "fastmap";
				qcom,iommu-faults = "stall-disable\0HUPCF\0non-fatal";
				qcom,iommu-dma-addr-pool = <0xa0000000 0x10000000>;
				qcom,iommu-geometry = <0xa0000000 0x10010000>;
				dma-coherent;
				qcom,fw-prefix;
				qcom,wlan;
				tsens = "quiet-therm";
				qcom,wlan-msa-fixed-region = <0xffffffff>;
				vdd-cx-mx-supply = <0xffffffff>;
				qcom,vdd-cx-mx-config = <0xd6d80 0x111700 0x00 0x00 0x01>;
				vdd-1.8-xo-supply = <0xffffffff>;
				qcom,vdd-1.8-xo-config = <0x1c9080 0x1f20c0 0x00 0x00 0x00>;
				vdd-1.3-rfa-supply = <0xffffffff>;
				qcom,vdd-1.3-rfa-config = <0x132a40 0x16e360 0x00 0x00 0x00>;
				qcom,smem-states = <0xffffffff 0x00 0x02 0x00 0x03 0x00>;
				qcom,smem-state-names = "wlan-smp2p-out\0wlan-soc-wake-smp2p-out\0wlan-ep-powersave-smp2p-out";
				mboxes = <0xffffffff 0x00>;
				qcom,vreg_ol_cpr = "s7b";
				phandle = <0x34>;

				qcom,icnss_cdev1 {
					#cooling-cells = <0x02>;
					phandle = <0x35>;
				};

				qcom,icnss_cdev2 {
					#cooling-cells = <0x02>;
					phandle = <0x36>;
				};

				qcom,smp2p_map_wlan_1_in {
					interrupts-extended = <0xffffffff 0x00 0x00 0xffffffff 0x01 0x00>;
					interrupt-names = "qcom,smp2p-force-fatal-error\0qcom,smp2p-early-crash-ind";
				};

				qcom,smp2p_map_wlan_2_in {
					interrupts-extended = <0x04 0x00 0x00>;
					interrupt-names = "qcom,smp2p-soc-wake-ack";
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			nq@64 {
				compatible = "rtc6226";
				reg = <0x64>;
				fmint-gpio = <0xffffffff 0x69 0x00>;
				vdd-supply = <0xffffffff>;
				rtc6226,vdd-supply-voltage = <0x2ab980 0x2ab980>;
				rtc6226,vdd-load = <0x3a98>;
				vio-supply = <0xffffffff>;
				rtc6226,vio-supply-voltage = <0x1b7740 0x1b7740>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmk8350@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x37>;

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos\0pon_pbs";
					qcom,log-kpd-event;
					phandle = <0x38>;

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc7";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <0x05>;
					phandle = <0x06>;

					pmk8350_ref_gnd {
						reg = <0x00>;
						label = "pmk8350_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8350_vref_1p25 {
						reg = <0x01>;
						label = "pmk8350_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8350_die_temp {
						reg = <0x03>;
						label = "pmk8350_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8350_xo_therm {
						reg = <0x44>;
						label = "pmk8350_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_ref_gnd {
						reg = <0x600>;
						label = "pmr735a_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_vref_1p25 {
						reg = <0x601>;
						label = "pmr735a_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_die_temp {
						reg = <0x603>;
						label = "pmr735a_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm6450_ref_gnd {
						reg = <0x100>;
						label = "pm6450_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm6450_vref_1p25 {
						reg = <0x101>;
						label = "pm6450_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm6450_die_temp {
						reg = <0x103>;
						label = "pm6450_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm6450_quiet_therm {
						reg = <0x14a>;
						label = "pm6450_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				adc_tm@3400 {
					compatible = "qcom,adc-tm7";
					reg = <0x3400>;
					interrupts = <0x00 0x34 0x00 0x01>;
					interrupt-names = "threshold";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <0x06 0x44 0x06 0x14a>;
					phandle = <0x12>;

					pmk8350_xo_therm {
						reg = <0x44>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm6450_quiet_therm {
						reg = <0x14a>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x39>;

					ufs_dev@94 {
						reg = <0x94 0x01>;
						bits = <0x00 0x00>;
						phandle = <0x26>;
					};
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x3a>;

					restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x10>;
					};
				};

				sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x11>;
				};

				sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x3b>;
				};

				sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x3c>;
				};

				sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x3d>;
				};

				sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x3e>;
				};

				sdam@8600 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8600>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x3f>;

					scaling@bf {
						reg = <0xbf 0x01>;
						bits = <0x00 0x02>;
						phandle = <0x40>;
					};
				};

				sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x41>;
				};

				sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x42>;
				};

				pinctrl@b000 {
					compatible = "qcom,pmk8350-gpio";
					reg = <0xb000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x43>;
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc\0alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0x44>;
				};
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm6450@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x07>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm6450-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x25>;

					key_vol_up {

						key_vol_up_default {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0x24>;
						};
					};

					quiet_therm {

						quiet_therm_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x05>;
						};
					};

					pm8010i_reset {

						pm8010i_active {
							pins = "gpio3";
							function = "normal";
							bias-disable;
							output-high;
							power-source = <0x00>;
							phandle = <0x14>;
						};
					};

					pm8010j_reset {

						pm8010j_active {
							pins = "gpio4";
							function = "normal";
							bias-disable;
							output-high;
							power-source = <0x00>;
							phandle = <0x16>;
						};
					};

					lcd_backlight_ctrl {

						lcd_backlight_pwm_default {
							pins = "gpio7";
							function = "func1";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x01>;
							qcom,drive-strength = <0x02>;
							phandle = <0x45>;
						};
					};
				};

				qcom,pwms@e800 {
					status = "ok";
					compatible = "qcom,pwm-lpg";
					reg = <0xe800>;
					reg-names = "lpg-base";
					qcom,num-lpg-channels = <0x01>;
					#pwm-cells = <0x02>;
					phandle = <0x46>;
				};
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			pm6450_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x07>;
				phandle = <0x47>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x22>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x48>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm6150l@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x49>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
					status = "disabled";
					phandle = <0x0b>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800>;
					status = "disabled";
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x04 0x24 0x00 0x03>;
					io-channels = <0x08 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x0d>;
				};

				bcl@3d00 {
					compatible = "qcom,bcl-v5";
					reg = <0x3d00>;
					interrupts = <0x04 0x3d 0x00 0x00 0x04 0x3d 0x01 0x00 0x04 0x3d 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					#thermal-sensor-cells = <0x01>;
					phandle = <0x0e>;
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x04 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <0x09 0x0a>;
					phandle = <0x08>;

					ref_gnd {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pa_therm2 {
						reg = <0x4d>;
						label = "pa_therm2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1 {
						reg = <0x4f>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					ufs_therm {
						reg = <0x52>;
						label = "ufs_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					wide_rfc_therm {
						reg = <0x54>;
						label = "wide_rfc_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500>;
					interrupts = <0x04 0x35 0x00 0x01>;
					interrupt-names = "threshold";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <0x08 0x4d 0x08 0x4f 0x08 0x52 0x08 0x54>;
					phandle = <0x13>;

					pa_therm2 {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm1 {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					ufs_therm {
						reg = <0x52>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					wide_rfc_therm {
						reg = <0x54>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};

				clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm6150l_div_clk1";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					status = "disabled";
					phandle = <0x4a>;
				};

				pinctrl@c000 {
					compatible = "qcom,pm6150l-gpio";
					reg = <0xc000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x18>;

					ufs_therm {

						ufs_therm_default {
							pins = "gpio5";
							bias-high-impedance;
							phandle = <0x09>;
						};
					};

					wide_rfc_therm {

						wide_rfc_therm_default {
							pins = "gpio7";
							bias-high-impedance;
							phandle = <0x0a>;
						};
					};

					display_panel_supply_ctrl {

						display_panel_vddio_default {
							pins = "gpio9";
							function = "normal";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
							phandle = <0x1a>;
						};

						display_panel_avdd_default {
							pins = "gpio4";
							function = "normal";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
							phandle = <0x1c>;
						};

						display_panel_extvdd_default {
							pins = "gpio3";
							function = "normal";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
							phandle = <0x1e>;
						};
					};

					lcd_backlight_ctrl {

						lcd_backlight_en_default {
							pins = "gpio10";
							function = "normal";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							qcom,drive-strength = <0x02>;
							phandle = <0x4b>;
						};
					};
				};
			};

			qcom,pm6150l@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x4c>;

				qcom,pwms@bc00 {
					status = "disabled";
					compatible = "qcom,pwm-lpg";
					reg = <0xbc00>;
					reg-names = "lpg-base";
					qcom,num-lpg-channels = <0x01>;
					#pwm-cells = <0x02>;
					phandle = <0x4d>;
				};

				qcom,lcdb@ec00 {
					compatible = "qcom,lcdb-pm6150l";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0xec00>;
					interrupts = <0x05 0xec 0x01 0x01>;
					interrupt-names = "sc-irq";
					qcom,pmic-revid = <0x0b>;
					qcom,voltage-step-ramp;
					status = "disabled";
					phandle = <0x4e>;

					ldo {
						label = "ldo";
						regulator-name = "lcdb_ldo";
						regulator-min-microvolt = "\0=\t";
						regulator-max-microvolt = <0x5b8d80>;
						phandle = <0x4f>;
					};

					ncp {
						label = "ncp";
						regulator-name = "lcdb_ncp";
						regulator-min-microvolt = "\0=\t";
						regulator-max-microvolt = <0x5b8d80>;
						phandle = <0x50>;
					};

					bst {
						label = "bst";
						regulator-name = "lcdb_bst";
						regulator-min-microvolt = <0x47b760>;
						regulator-max-microvolt = <0x5fbfb8>;
						phandle = <0x51>;
					};
				};

				qcom,leds@d300 {
					compatible = "qcom,pm6150l-flash-led-v2";
					status = "ok";
					reg = <0xd300>;
					label = "flash";
					interrupts = <0x05 0xd3 0x00 0x01 0x05 0xd3 0x03 0x01 0x05 0xd3 0x04 0x01>;
					interrupt-names = "led-fault-irq\0all-ramp-down-done-irq\0all-ramp-up-done-irq";
					qcom,hdrm-auto-mode;
					qcom,short-circuit-det;
					qcom,open-circuit-det;
